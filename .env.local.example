# Shopify Admin API (client_credentials grant) — see lib/shopify/adminAuth.ts
# Real values come from this project's Shopify Dev Dashboard app (Settings > Credentials).
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# Optional. Absolute URL of this app as reached from outside (tunnel or real
# deployment). Only needed when testing through the Shopify App Proxy — see
# next.config.ts. Leave unset for plain standalone hosting.
ASSET_PREFIX=
